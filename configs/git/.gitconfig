[user]
	name = Nikita Lozgachev
[init]
	defaultBranch = main
[core]
	editor = hx
	pager = delta
	excludesfile = ~/.config/git/ignore
	attributesfile = ~/.config/git/attributes
	precomposeUnicode = true
	fsmonitor = true
[credential]
	helper = osxkeychain
[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = true
	side-by-side = true
	line-numbers = true
	syntax-theme = ansi
[commit]
	gpgsign = true
[gpg]
	program = gpg
[pull]
	rebase = true
[push]
	autoSetupRemote = true
[fetch]
	prune = true
[diff]
	algorithm = histogram
	colorMoved = default
[merge]
	conflictstyle = zdiff3
[merge "mergiraf"]
	name = mergiraf
	driver = mergiraf merge --git %O %A %B -s %S -x %X -y %Y -p %P -l %L
[rebase]
	autoStash = true
	updateRefs = true
[rerere]
	enabled = true
	autoupdate = true
[branch]
	sort = -committerdate
[alias]
	adog = log --all --decorate --oneline --graph
[include]
	path = ~/.gitconfig-local
