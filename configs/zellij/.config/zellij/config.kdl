simplified_ui true
pane_frames true
show_startup_tips false
pane_frame_style "full"
default_shell "fish"
theme "tomorrow-night-blue"
copy_command "pbcopy"
copy_on_select true
copy_clipboard "system"

ui {
    pane_frames {
        rounded_corners true
    }
}

themes {
    tomorrow-night-blue {
        fg "#ffffff"
        bg "#002451"
        black "#183d6e"
        red "#f2777a"
        green "#ffeead"
        yellow "#ffeead"
        blue "#bbdaff"
        magenta "#ebbbff"
        cyan "#66cccc"
        white "#ffffff"
        orange "#e78c45"
    }
}

keybinds clear-defaults=true {
    shared_except "tmux" "locked" {
        bind "Ctrl a" { SwitchToMode "Tmux"; }
        bind "Ctrl q" { Quit; }
    }

    locked {
        bind "Ctrl g" { SwitchToMode "Normal"; }
    }

    tmux {
        bind "Ctrl a" { Write 1; SwitchToMode "Normal"; }
        bind "Esc" "Enter" { SwitchToMode "Normal"; }

        bind "p" "Ctrl p" { SwitchToMode "Pane"; }
        bind "t" "Ctrl t" { SwitchToMode "Tab"; }
        bind "r" "Ctrl r" { SwitchToMode "Resize"; }
        bind "m" "Ctrl m" { SwitchToMode "Move"; }
        bind "s" "Ctrl s" { SwitchToMode "Scroll"; }

        bind "d" "Ctrl d" { Detach; }
        bind "q" "Ctrl q" { Quit; }

        bind "?" { LaunchOrFocusPlugin "configuration" { floating true; }; SwitchToMode "Normal"; }
    }

    pane {
        bind "Esc" "Enter" { SwitchToMode "Normal"; }
        bind "|" { NewPane "Right"; SwitchToMode "Normal"; }
        bind "-" { NewPane "Down"; SwitchToMode "Normal"; }
        bind "n" { NewPane; SwitchToMode "Normal"; }
        bind "," "c" { SwitchToMode "RenamePane"; PaneNameInput 0; }
        bind "b" { BreakPane; SwitchToMode "Normal"; }
        bind "[" { BreakPaneLeft; SwitchToMode "Normal"; }
        bind "]" { BreakPaneRight; SwitchToMode "Normal"; }
        bind "z" "Ctrl z" { ToggleFocusFullscreen; SwitchToMode "Normal"; }
        bind "x" "Ctrl x" { CloseFocus; SwitchToMode "Normal"; }
        bind "w" "Ctrl w" { ToggleFloatingPanes; SwitchToMode "Normal"; }
        bind "h" "Ctrl h" "Left"  { MoveFocus "Left"; SwitchToMode "Normal"; }
        bind "j" "Ctrl j" "Down"  { MoveFocus "Down"; SwitchToMode "Normal"; }
        bind "k" "Ctrl k" "Up"    { MoveFocus "Up"; SwitchToMode "Normal"; }
        bind "l" "Ctrl l" "Right" { MoveFocus "Right"; SwitchToMode "Normal"; }
        bind "o" "Ctrl o"         { FocusNextPane; SwitchToMode "Normal"; }
    }

    tab {
        bind "Esc" "Enter" { SwitchToMode "Normal"; }
        bind "c" "Ctrl c" { NewTab; SwitchToMode "Normal"; }
        bind "," { SwitchToMode "RenameTab"; TabNameInput 0; }
        bind "h" "Ctrl h" "Left"  { MoveTab "Left"; }
        bind "l" "Ctrl l" "Right" { MoveTab "Right"; }
        bind "1" { GoToTab 1; SwitchToMode "Normal"; }
        bind "2" { GoToTab 2; SwitchToMode "Normal"; }
        bind "3" { GoToTab 3; SwitchToMode "Normal"; }
        bind "4" { GoToTab 4; SwitchToMode "Normal"; }
        bind "5" { GoToTab 5; SwitchToMode "Normal"; }
        bind "6" { GoToTab 6; SwitchToMode "Normal"; }
        bind "7" { GoToTab 7; SwitchToMode "Normal"; }
        bind "8" { GoToTab 8; SwitchToMode "Normal"; }
        bind "9" { GoToTab 9; SwitchToMode "Normal"; }
        bind "Tab" { GoToNextTab; SwitchToMode "Normal"; }
        bind "p" "Ctrl p" { GoToPreviousTab; SwitchToMode "Normal"; }
        bind "x" "Ctrl x" { CloseTab; SwitchToMode "Normal"; }
    }

    scroll {
        bind "Esc" "q" { SwitchToMode "Normal"; }
        bind "e" { EditScrollback; SwitchToMode "Normal"; }
        bind "s" "/" { SwitchToMode "EnterSearch"; SearchInput 0; }
        bind "j" "Down" { ScrollDown; }
        bind "k" "Up" { ScrollUp; }
        bind "Ctrl d" "PageDown" { PageScrollDown; }
        bind "Ctrl u" "PageUp" { PageScrollUp; }
        bind "d" { HalfPageScrollDown; }
        bind "u" { HalfPageScrollUp; }
    }

    search {
        bind "Esc" "q" { SwitchToMode "Normal"; }
        bind "j" "Down" { ScrollDown; }
        bind "k" "Up" { ScrollUp; }
        bind "Ctrl d" "PageDown" { PageScrollDown; }
        bind "Ctrl u" "PageUp" { PageScrollUp; }
        bind "n" { Search "down"; }
        bind "p" { Search "up"; }
    }

    entersearch {
        bind "Esc" { SwitchToMode "Scroll"; }
        bind "Enter" { SwitchToMode "Search"; }
    }

    renametab {
        bind "Esc" { UndoRenameTab; SwitchToMode "Normal"; }
        bind "Enter" { SwitchToMode "Normal"; }
    }

    renamepane {
        bind "Esc" { UndoRenamePane; SwitchToMode "Normal"; }
        bind "Enter" { SwitchToMode "Normal"; }
    }

    resize {
        bind "Esc" "Enter" { SwitchToMode "Normal"; }
        bind "h" "Left"  { Resize "Increase Left"; }
        bind "j" "Down"  { Resize "Increase Down"; }
        bind "k" "Up"    { Resize "Increase Up"; }
        bind "l" "Right" { Resize "Increase Right"; }
        bind "H" { Resize "Decrease Left"; }
        bind "J" { Resize "Decrease Down"; }
        bind "K" { Resize "Decrease Up"; }
        bind "L" { Resize "Decrease Right"; }
        bind "=" "+" { Resize "Increase"; }
        bind "-" { Resize "Decrease"; }
    }

    move {
        bind "Esc" "Enter" { SwitchToMode "Normal"; }
        bind "h" "Left"  { MovePane "Left"; }
        bind "j" "Down"  { MovePane "Down"; }
        bind "k" "Up"    { MovePane "Up"; }
        bind "l" "Right" { MovePane "Right"; }
        bind "n" "Tab"   { MovePane; }
        bind "p"         { MovePaneBackwards; }
    }
}
